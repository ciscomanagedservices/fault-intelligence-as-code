# DEVNET-3171 -- Webhook relay environment
#
# Copy this file to `.env` (which is gitignored) and fill in real values.
# `docker compose up` will load it automatically.

# ---------------------------------------------------------------------------
# OpenCode server (headless) -- must be running on the host before the relay
# ---------------------------------------------------------------------------

# URL the relay uses to reach `opencode serve`. When the relay runs in a
# container and OpenCode runs on the host, use host.docker.internal.
OPENCODE_URL=http://host.docker.internal:4096

# Basic auth for the OpenCode server. Set this when starting `opencode serve`
# via OPENCODE_SERVER_PASSWORD; the relay sends matching credentials.
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=

# strict | hybrid-reasoning
REMEDIATION_MODE=strict

# Optional shared secret for /fault-alert webhook (Splunk -> relay).
# Leave empty to disable verification.
WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Webex notifications + human-in-the-loop approval
# ---------------------------------------------------------------------------

# Bot access token from developer.webex.com
WEBEX_BOT_TOKEN=

# Room ID where notifications and approval cards are sent
WEBEX_ROOM_ID=

# ---------------------------------------------------------------------------
# Splunk REST API reverse proxy
# ---------------------------------------------------------------------------
# Optional. The relay exposes /splunk/<path> and forwards to
# <SPLUNK_UPSTREAM_URL>/<path>. Leave empty unless you are proxying Splunk REST
# through the relay for a lab or demo.
SPLUNK_UPSTREAM_URL=

# Set to "true" to enforce TLS verification against the Splunk certificate.
SPLUNK_VERIFY_TLS=false

# ---------------------------------------------------------------------------
# Optional public URL
# ---------------------------------------------------------------------------
# Informational only -- the relay itself does not read this. If you use a
# tunnel or reverse proxy for Webex/Splunk callbacks, record its URL here for
# your local operators.
PUBLIC_RELAY_URL=

# ---------------------------------------------------------------------------
# RADKit health check
# ---------------------------------------------------------------------------

# Optional. `/health/deep` probes this URL from the relay network namespace.
# Leave empty for the relay's direct-run default. Docker Compose supplies
# http://host.docker.internal:8000/mcp when this value is empty.
# The actual RADKit MCP endpoint used by OpenCode is configured in opencode.json.
RADKIT_MCP_URL=

# ---------------------------------------------------------------------------
# MCP server credentials (used by opencode.json via {env:VAR} substitution)
# ---------------------------------------------------------------------------

# Cisco Support API (mcp-cisco-support), optional for customer demos.
CISCO_CLIENT_ID=
CISCO_CLIENT_SECRET=

# Cisco Docs AI MCP, optional for customer demos.
CISCO_DOCS_API_KEY=
