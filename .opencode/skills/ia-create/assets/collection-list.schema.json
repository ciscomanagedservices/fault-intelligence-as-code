{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "diagnostic-collection-list/v1.0.0",
  "title": "Diagnostic Data Collection List",
  "description": "Schema for Health Intelligence diagnostic data collection list artifacts.",
  "type": "object",
  "required": [
    "name",
    "id",
    "version",
    "description",
    "category",
    "component",
    "os_types",
    "collections",
    "tags",
    "created_by",
    "created_date"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]+$",
      "description": "Unique identifier in UPPERCASE_SNAKE_CASE."
    },
    "id": {
      "type": "string",
      "pattern": "^CL\\d{6}$",
      "description": "Unique string ID with CL prefix and 6-digit zero-padded suffix (e.g. CL000001, CL000042)."
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version string (e.g., '1.0.0')."
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "description": "Human-readable description of the collection purpose."
    },
    "category": {
      "type": "string",
      "enum": ["hardware", "software", "interface", "protocol", "system"],
      "description": "Functional category of the collected data."
    },
    "component": {
      "type": "string",
      "minLength": 1,
      "description": "Target hardware or software component (e.g., OPTICS, CPU, BGP)."
    },
    "product_ids": {
      "type": "array",
      "items": { "type": "string" },
      "description": "List of supported hardware product IDs (PIDs)."
    },
    "os_types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["IOS-XR", "NX-OS", "IOS-XE", "SONiC"]
      },
      "description": "Supported OS types."
    },
    "os_versions": {
      "type": "string",
      "description": "Version constraint string (e.g., '>=7.5.0')."
    },
    "collections": {
      "type": "array",
      "minItems": 1,
      "description": "List of data collection items.",
      "items": {
        "$ref": "#/definitions/collection_item"
      }
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$",
        "description": "Lowercase tag."
      },
      "description": "Classification tags (lowercase only)."
    },
    "created_by": {
      "type": "string",
      "minLength": 1,
      "description": "Author or team name."
    },
    "created_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "ISO 8601 creation date (YYYY-MM-DD)."
    }
  },
  "definitions": {
    "collection_item": {
      "type": "object",
      "required": ["id", "name", "type", "priority", "output"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]+$",
          "description": "Unique item identifier within this list (lowercase_snake_case)."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable name for this collection item."
        },
        "type": {
          "type": "string",
          "enum": ["cli", "gnmi_get", "gnmi_subscribe", "netconf", "api"],
          "description": "Collection method."
        },
        "priority": {
          "type": "string",
          "enum": ["required", "recommended", "optional"],
          "description": "Collection priority."
        },
        "cli": { "$ref": "#/definitions/cli_block" },
        "gnmi": { "$ref": "#/definitions/gnmi_block" },
        "netconf": { "$ref": "#/definitions/netconf_block" },
        "output": { "$ref": "#/definitions/output_block" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "cli" } } },
          "then": { "required": ["cli"] }
        },
        {
          "if": {
            "properties": { "type": { "enum": ["gnmi_get", "gnmi_subscribe"] } }
          },
          "then": { "required": ["gnmi"] }
        },
        {
          "if": { "properties": { "type": { "const": "netconf" } } },
          "then": { "required": ["netconf"] }
        }
      ]
    },
    "cli_block": {
      "type": "object",
      "required": ["command"],
      "additionalProperties": false,
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1,
          "description": "CLI command to execute. Use {{ variable }} for parameters."
        },
        "parser_ref": {
          "type": "string",
          "pattern": "^PARSE_[A-Z][A-Z0-9_]+$",
          "description": "Reference to a Parser artifact by name."
        },
        "timeout": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300,
          "description": "Command timeout in seconds."
        }
      }
    },
    "gnmi_block": {
      "type": "object",
      "required": ["path"],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "YANG path (OpenConfig or native). Use {{ variable }} for parameters."
        },
        "origin": {
          "type": "string",
          "description": "gNMI origin (e.g., openconfig, cisco-ios-xr)."
        },
        "encoding": {
          "type": "string",
          "enum": ["json", "json_ietf", "proto"],
          "description": "gNMI encoding format."
        },
        "mode": {
          "type": "string",
          "enum": ["get", "subscribe_once", "subscribe_stream"],
          "description": "gNMI operation mode."
        },
        "sample_interval": {
          "type": "integer",
          "minimum": 0,
          "description": "Streaming sample interval in milliseconds."
        }
      }
    },
    "netconf_block": {
      "type": "object",
      "required": ["xpath"],
      "additionalProperties": false,
      "properties": {
        "xpath": {
          "type": "string",
          "minLength": 1,
          "description": "XPath filter expression."
        },
        "namespace": {
          "type": "string",
          "description": "XML namespace URI."
        }
      }
    },
    "output_block": {
      "type": "object",
      "required": ["format", "store_as"],
      "additionalProperties": false,
      "properties": {
        "format": {
          "type": "string",
          "enum": ["text", "json", "xml", "table"],
          "description": "Output format."
        },
        "store_as": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]+$",
          "description": "Variable name for parsed output (lowercase_snake_case)."
        }
      }
    }
  }
}
